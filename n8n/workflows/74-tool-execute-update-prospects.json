  "name": "74 - TOOL - execute_update_prospects",
  "nodes": [
    {
      "parameters": {
        "content": "## Confirmed update executor\nOnly 40 - CONFIRM - Task Write calls this workflow, after the user has replied with the exact confirmation phrase. It posts the stored, already-validated field updates to the chat app's local prospect store. It is not wired to the agent as a tool.",
        "height": 300,
