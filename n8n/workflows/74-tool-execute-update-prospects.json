      "id": "74000000-0000-4000-8000-000000000002",
      "name": "Tool Input"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const sessionId = typeof $json.sessionId === 'string' ? $json.sessionId.trim() : '';\nconst requestId = typeof $json.requestId === 'string' ? $json.requestId.trim() : '';\nconst proposedInputJson = typeof $json.proposedInputJson === 'string' ? $json.proposedInputJson : '';\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nlet error = null;\nlet proposedInput = null;\n\nif (!uuidPattern.test(sessionId)) {\n  error = { code: 'INVALID_SESSION', message: 'The confirmed update needs a valid conversation session.' };\n} else if (!uuidPattern.test(requestId)) {\n  error = { code: 'INVALID_REQUEST', message: 'The confirmed update needs the confirmed action ID.' };\n} else {\n  try { proposedInput = JSON.parse(proposedInputJson); } catch {\n    error = { code: 'INVALID_STORED_PROPOSAL', message: 'The stored update proposal is invalid. Ask for a new proposal.' };\n  }\n  if (!error && (\n    typeof proposedInput?.brand !== 'string' ||\n    !Array.isArray(proposedInput?.updates) ||\n    proposedInput.updates.length === 0 ||\n    proposedInput.updates.length > 100\n  )) {\n    error = { code: 'INVALID_STORED_PROPOSAL', message: 'The stored update proposal is invalid. Ask for a new proposal.' };\n  }\n}\n\nreturn {\n  json: {\n    valid: error === null,\n    sessionId,\n    requestId,\n    brand: proposedInput?.brand ?? '',\n    updates: proposedInput?.updates ?? [],\n    auditInput: { brand: proposedInput?.brand ?? '', updateCount: proposedInput?.updates?.length ?? 0 },\n    ...(error ? { response: { ok: false, error } } : {})\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        80
      ],
      "id": "74000000-0000-4000-8000-000000000003",
      "name": "Validate Confirmed Update"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "74000000-0000-4000-8000-000000000004",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
