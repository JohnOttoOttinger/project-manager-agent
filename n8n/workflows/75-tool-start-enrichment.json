        "url": "={{ 'http://127.0.0.1:3000/api/prospects/enrichable?brand=' + encodeURIComponent($('Validate Enrichment Input').item.json.brand) + '&limit=' + $('Validate Enrichment Input').item.json.limit + ($('Validate Enrichment Input').item.json.listName !== '' ? '&list=' + encodeURIComponent($('Validate Enrichment Input').item.json.listName) : '') }}",
