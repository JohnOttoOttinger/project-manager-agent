    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const sessionId = typeof $json.sessionId === 'string' ? $json.sessionId.trim() : '';\nconst requestId = typeof $json.requestId === 'string' ? $json.requestId.trim() : '';\nconst brand = typeof $json.brand === 'string' ? $json.brand.trim().toLowerCase() : '';\nconst listName = typeof $json.listName === 'string' ? $json.listName.trim() : '';\nconst rawLimit = typeof $json.limit === 'string' ? $json.limit.trim() : '';\nconst limit = rawLimit === '' ? 33 : Number.parseInt(rawLimit, 10);\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst brandPattern = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;\nlet error = null;\n\nif (!uuidPattern.test(sessionId)) {\n  error = { code: 'INVALID_SESSION', message: 'The enrichment request needs a valid conversation session.' };\n} else if (!uuidPattern.test(requestId)) {\n  error = { code: 'INVALID_REQUEST', message: 'The enrichment request could not be identified. Send the message again.' };\n} else if (brand === '' || brand.length > 40 || !brandPattern.test(brand)) {\n  error = { code: 'INVALID_BRAND', message: 'Say which brand to enrich prospects for, such as oddtoe or datalabs.' };\n} else if (!Number.isInteger(limit) || limit < 1 || limit > 100) {\n  error = { code: 'INVALID_LIMIT', message: 'The enrichment limit must be a whole number between 1 and 100.' };\n} else if (listName.length > 120) {\n  error = { code: 'INVALID_LIST', message: 'The list name must be 120 characters or fewer.' };\n}\n\nreturn {\n  json: {\n    valid: error === null,\n    sessionId,\n    requestId,\n    brand,\n    listName,\n    limit,\n    proposedInput: { brand, listName, limit },\n    ...(error ? { response: { ok: false, error } } : {})\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        80
      ],
      "id": "75000000-0000-4000-8000-000000000003",
