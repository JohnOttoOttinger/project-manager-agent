    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('Validate Enrichment Input').first().json;\nconst body = $json;\nif (body?.schemaVersion !== 1 || !Array.isArray(body.eligible)) {\n  return [{\n    json: {\n      ...input,\n      ready: false,\n      response: {\n        ok: false,\n        error: {\n          code: 'PROSPECT_DATA_UNAVAILABLE',\n          message: 'The local prospect store is not available. Check the chat app is running, then try again.'\n        }\n      }\n    }\n  }];\n}\nconst eligible = body.eligible;\nconst missingUrl = Array.isArray(body.missingUrl) ? body.missingUrl : [];\nif (eligible.length === 0) {\n  const urlNote = missingUrl.length > 0\n    ? ` ${missingUrl.length} prospect(s) are waiting on a LinkedIn company URL first: ${missingUrl.slice(0, 10).join(', ')}${missingUrl.length > 10 ? '\u2026' : ''}. Propose updates to fill linkedinCompanyUrl, then start enrichment again.`\n    : ' Import prospects first, or check that they are not already enriched.';\n  return [{\n    json: {\n      ...input,\n      ready: false,\n      response: {\n        ok: true,\n        started: false,\n        message: `No prospects are ready to enrich.${urlNote}`,\n        missingUrlCount: missingUrl.length\n      }\n    }\n  }];\n}\nconst estimatedCostUsd = Math.round(eligible.length * (0.02 + 3 * 0.012) * 100) / 100;\nreturn [{\n  json: {\n    ...input,\n    ready: true,\n    eligible,\n    missingUrl,\n    estimatedCostUsd\n  }\n}];"
      },
