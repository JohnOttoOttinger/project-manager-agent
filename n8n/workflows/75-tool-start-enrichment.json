    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const prepared = $('Check Eligible Prospects').first().json;\nconst body = $json;\nif (body?.schemaVersion !== 1 || !body.job?.jobId) {\n  return [{\n    json: {\n      ...prepared,\n      response: {\n        ok: false,\n        error: {\n          code: 'JOB_REGISTRATION_FAILED',\n          message: 'The enrichment job could not be registered. Check the chat app is running, then try again.'\n        }\n      }\n    }\n  }];\n}\nconst missingNote = prepared.missingUrl.length > 0\n  ? ` ${prepared.missingUrl.length} prospect(s) were skipped because they have no LinkedIn company URL yet.`\n  : '';\nreturn [{\n  json: {\n    ...prepared,\n    jobId: body.job.jobId,\n    alreadyRunning: body.created === false,\n    response: {\n      ok: true,\n      started: body.created !== false,\n      jobId: body.job.jobId,\n      companies: prepared.eligible.length,\n      estimatedCostUsd: prepared.estimatedCostUsd,\n      missingUrlCount: prepared.missingUrl.length,\n      message: body.created === false\n        ? `An enrichment job for this request already exists (job ${body.job.jobId}). Use get_enrichment to check it.`\n        : `Enrichment started for ${prepared.eligible.length} compan${prepared.eligible.length === 1 ? 'y' : 'ies'} (job ${body.job.jobId}). Estimated provider cost about $${prepared.estimatedCostUsd} from the Apify free credit.${missingNote} It runs in the background \u2014 ask again in a few minutes and I will use get_enrichment to report.`\n    }\n  }\n}];"
      },
