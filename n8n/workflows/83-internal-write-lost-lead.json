    {
      "id": "n5",
      "name": "Shape Write Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -160
      ],
      "parameters": {
        "jsCode": "const input = $('Validate Write Input').first().json;\nif (!Number.isInteger($json.id)) {\n  return {\n    json: {\n      ...input,\n      response: {\n        ok: false,\n        error: {\n          code: 'LOST_LEAD_DATA_UNAVAILABLE',\n          message: 'The lost lead could not be saved. Run 13 - SETUP - Lost Lead Data, then ask for a new proposal.'\n        }\n      }\n    }\n  };\n}\nreturn {\n  json: {\n    ...input,\n    response: {\n      ok: true,\n      lead: { leadId: input.leadId, company: input.proposedInput.company, lostDate: input.proposedInput.lostDate },\n      summary: `Lost lead ${input.leadId} (${input.proposedInput.company}) is recorded.`,\n      message: `Lost lead ${input.leadId} for ${input.proposedInput.company} was saved.`\n    }\n  }\n};"
      }
    },
    {
      "id": "a1",
      "name": "Prepare Audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
