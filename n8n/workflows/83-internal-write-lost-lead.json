    {
      "id": "n3",
      "name": "Decide Write Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        -90
      ],
      "parameters": {
        "jsCode": "const input = $('Validate Write Input').first().json;\nconst rows = $input.all().map((item) => item.json).filter((row) => Number.isInteger(row.id));\nif (rows.length > 0) {\n  const existing = rows[0];\n  return [{\n    json: {\n      ...input,\n      insert: false,\n      response: {\n        ok: true,\n        repeated: true,\n        lead: { leadId: String(existing.leadId ?? ''), company: String(existing.company ?? '') },\n        message: 'This confirmed lost lead was already recorded. Nothing changed.'\n      }\n    }\n  }];\n}\nreturn [{ json: { ...input, insert: true } }];"
      }
    },
