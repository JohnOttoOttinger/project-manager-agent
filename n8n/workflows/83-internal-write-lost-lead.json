    {
      "id": "n1",
      "name": "Validate Write Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ],
      "parameters": {
        "jsCode": "const sessionId = typeof $json.sessionId === 'string' ? $json.sessionId.trim() : '';\nconst requestId = typeof $json.requestId === 'string' ? $json.requestId.trim() : '';\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nlet proposedInput = null;\nlet error = null;\n\nif (!uuidPattern.test(sessionId) || !uuidPattern.test(requestId)) {\n  error = { code: 'INVALID_REQUEST', message: 'The confirmed write is missing its session or request identifier.' };\n} else {\n  try {\n    proposedInput = JSON.parse(typeof $json.proposedInputJson === 'string' ? $json.proposedInputJson : '');\n  } catch {\n    error = { code: 'INVALID_STORED_PROPOSAL', message: 'The confirmed proposal could not be read.' };\n  }\n}\nconst required = ['contactName', 'company', 'offer', 'source', 'enquiryDate', 'lostDate'];\nif (!error && (typeof proposedInput !== 'object' || proposedInput === null ||\n    !required.every((key) => typeof proposedInput[key] === 'string' && proposedInput[key].trim() !== ''))) {\n  error = { code: 'INVALID_STORED_PROPOSAL', message: 'The confirmed proposal is incomplete.' };\n}\n\nconst leadId = error ? '' : 'LL-' + Array.from({ length: 6 }, () => '0123456789abcdef'[Math.floor(Math.random() * 16)]).join('');\nreturn {\n  json: {\n    valid: error === null,\n    sessionId,\n    requestId,\n    leadId,\n    proposedInput: proposedInput ?? {},\n    ...(error ? { response: { ok: false, error } } : {})\n  }\n};"
      }
    },
    {
      "id": "n9",
      "name": "Input Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        20,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "54000000-0000-4000-8000-0000000161n9",
              "leftValue": "={{ $json.valid === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
