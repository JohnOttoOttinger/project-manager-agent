    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const sessionId = typeof $json.sessionId === 'string' ? $json.sessionId.trim() : '';\nconst jobId = typeof $json.jobId === 'string' ? $json.jobId.trim() : '';\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nlet error = null;\nif (!uuidPattern.test(sessionId)) {\n  error = { code: 'INVALID_SESSION', message: 'The enrichment check needs a valid conversation session.' };\n} else if (!uuidPattern.test(jobId)) {\n  error = { code: 'INVALID_JOB', message: 'Pass the exact enrichment job ID that start_enrichment returned in this conversation.' };\n}\nreturn {\n  json: {\n    valid: error === null,\n    sessionId,\n    jobId,\n    proposedInput: { jobId },\n    ...(error ? { response: { ok: false, error } } : {})\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        80
      ],
      "id": "77000000-0000-4000-8000-000000000003",
      "name": "Validate Job Request"
    },
