      "id": "77000000-0000-4000-8000-000000000005",
      "name": "Read Enrichment Job",
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('Validate Job Request').first().json;\nconst body = $json;\nif (body?.schemaVersion !== 1 || !body.job) {\n  const message = typeof body?.error?.message === 'string'\n    ? body.error.message\n    : 'That enrichment job is not registered to this conversation.';\n  return [{\n    json: {\n      ...input,\n      response: { ok: false, error: { code: 'ENRICHMENT_JOB_NOT_FOUND', message } }\n    }\n  }];\n}\nconst job = body.job;\nlet guidance;\nif (job.status === 'queued' || job.status === 'running') {\n  guidance = `Still working (stage: ${job.stage}). Ask again in a few minutes.`;\n} else if (job.status === 'failed') {\n  guidance = job.errorCode === 'APIFY_START_FAILED'\n    ? 'The Apify run could not start. The \"Apify API\" credential is probably missing in n8n \u2014 see docs/PROSPECT_ENRICHMENT.md, then start a new enrichment.'\n    : 'The job failed. Start a new enrichment after checking the error.';\n} else {\n  guidance = 'Finished. Use list_prospects to see the enriched contacts and anything flagged for review.';\n}\nreturn [{\n  json: {\n    ...input,\n    response: {\n      ok: true,\n      job: {\n        jobId: job.jobId,\n        status: job.status,\n        stage: job.stage,\n        brand: job.brand,\n        listName: job.listName,\n        targetCount: job.targetCount,\n        enrichedCount: job.enrichedCount,\n        flaggedCount: job.flaggedCount,\n        skipped: job.skipped,\n        providerCostUsd: job.providerCostUsd ?? null,\n        errorCode: job.errorCode ?? null,\n        errorMessage: job.errorMessage ?? null,\n        updatedAt: job.updatedAt\n      },\n      guidance\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "77000000-0000-4000-8000-000000000006",
      "name": "Shape Job Result"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const response = $json.response;\nconst error = response?.ok === false ? String(response.error?.message ?? 'Tool failed') : '';\nreturn {\n  json: {\n    occurredAt: new Date().toISOString(),\n    sessionId: String($json.sessionId ?? ''),\n    requestId: String(''),\n    toolName: 'get_enrichment',\n    proposedInput: JSON.stringify($json.auditInput ?? $json.proposedInput ?? {}),\n    result: JSON.stringify(response),\n    error,\n    response\n  }\n};"
      },
