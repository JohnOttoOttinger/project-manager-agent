      "name": "Input Is Valid?"
    },
    {
      "parameters": {
        "url": "={{ 'http://127.0.0.1:3000/api/prospects/enrichment-jobs?sessionId=' + encodeURIComponent($('Validate Job Request').item.json.sessionId) + '&jobId=' + encodeURIComponent($('Validate Job Request').item.json.jobId) }}",
        "options": {
